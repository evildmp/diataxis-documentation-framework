#: ../../compass.rst:48
#: 7a38c4fae8824d059e986f3a8b2db991
#: 497744224eae44c495b3e68b959c0ef7
msgid "acquisition of skill"
msgstr ""

#: ../../compass.rst:40
#: 990dc6284f5e408e8769cd75e257721a
msgid "a tutorial"
msgstr ""

#: ../../compass.rst:42
#: ../../compass.rst:45
#: 0dfb267ba058450e83450c748708b3cb
#: 95c6cc3afd9140cdb817f0e28bcc051a
msgid "application of skill"
msgstr ""

#: ../../compass.rst:43
