msgstr ""

#: ../../compass.rst:44
#: ../../compass.rst:47
#: 1e9c5b0dff3e4f5ca6a40e0383685ae3
#: 5cf4dbd1574f45f1913976566f17f6df
msgid "informs cognition"
msgstr ""

#: ../../compass.rst:46
#: 09e8ab962228442a995a13dea4bc72c4
msgid "reference"
msgstr ""

#: ../../compass.rst:49
#: ad37fcbba9fc4fa0816702cb984807b8
msgid "explanation"
msgstr ""

#: ../../compass.rst:51
#: 50def26a37f54180b2f14349407ee0e6
msgid "The compass can be applied equally to user situations that need documentation, or to documentation itself that perhaps needs to be moved or improved. Like many good tools, it's surprisingly banal."
msgstr ""

#: ../../compass.rst:53
#: 20fe21566e43470080244990904f72bd
msgid "To use the compass, just two questions need to be asked: *action or cognition?* *acquisition or application?*"
msgstr ""

#: ../../compass.rst:55
#: 90cc5adbff284b16ad2a3da082890b29
msgid "And it yields the answer."
msgstr ""

#: ../../compass.rst:59
#: c00e3c1f0d634864a88511f20cae1cd6
msgid "Using the compass"
msgstr ""

#: ../../compass.rst:61
#: 44098a0c104d42d09c633ce577cb1783
msgid "The compass is particularly effective when you think that you think you (or even the documentation in front of you) are doing one thing - but you are troubled by a sense of doubt, or by some difficulty in the work. The compass forces you to stop and reconsider."
msgstr ""

#: ../../compass.rst:63
#: f11c60a70c474b9598094cd061bd197b
msgid "Especially when you are trying to find your initial bearings, use the compass's terms flexibly; don't get fixated on the exact names."
msgstr ""

#: ../../compass.rst:65
#: 55840afaebdd497c90261b68149eb9c2
msgid "*action*: practical steps, doing"
msgstr ""

#: ../../compass.rst:66
#: 564cd37df94a449d8234ab6be4524895
msgid "*cognition*: theoretical or propositional knowledge, thinking"
msgstr ""

#: ../../compass.rst:67
#: 09fb977c570649fe969659c42f2e8fab
msgid "*acquisition*: study"
msgstr ""

#: ../../compass.rst:68
#: 072ab63c1406411cae008148226517cb
msgid "*application*: work"
msgstr ""

#: ../../compass.rst:70
#: edc20dda04404e24adbe03b53a6e07ea
msgid "And the questions themselves can also be used in different ways:"
msgstr ""

#: ../../compass.rst:72
#: f1bc0f1cc84944f087eda846cc0f4ac5
msgid "Do I think I am writing for *x* or *y*?"
msgstr ""

#: ../../compass.rst:73
#: a059b6aaa57d4929b4147e731e0fe50e
msgid "Is this writing in front of me engaged in *x* or *y*?"
msgstr ""

#: ../../compass.rst:74
#: c63ad43ad886477d979b91e0f0932720
msgid "Does the user need *x* or *y*?"
msgstr ""

#: ../../compass.rst:75
#: 4d427fdbaf9f4d3faf802f4db43440b5
msgid "Do I want to *x* or *y*?"
msgstr ""

#: ../../compass.rst:77
#: 4a174741a0174f6ba25903308f8b485e
msgid "And try applying them close-up, at the level of sentences and words, or from a wider perspective, considering an entire document."
msgstr ""
