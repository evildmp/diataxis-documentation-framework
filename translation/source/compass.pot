#: ../../compass.rst:4
#: 48dfdb07b88844fdbccf0ab4e56f41ce
msgid "The compass"
msgstr ""

#: ../../compass.rst:10
#: 1f1e550f02274b10ba14c7e9a8545aae
msgid "The Diátaxis map is an effective reminder of the different kinds of documentation and their relationship, and it accords well with intuitions about documentation."
msgstr ""

#: ../../compass.rst:14
#: 137fd4ffb42a4fe5ad67ab4aed3fc7af
msgid "However intuition is not always to be relied upon. Often when working with documentation, an author is faced with the question: *what form of documentation is this?* or *what form of documentation is needed here?* - and no obvious, intuitive answer."
msgstr ""

#: ../../compass.rst:19
#: 772f127d29a6422ba25c6d4bc20eb3f8
msgid "Worse, sometimes intuition provides an immediate answer that is also wrong."
msgstr ""

#: ../../compass.rst:21
#: 3b0e90f6997d4d93b858f2b9c2c86514
msgid "A map is most powerful in unfamiliar territory when we also have a compass to guide us."
msgstr ""

#: ../../compass.rst:24
#: f24ce33247434241b6d5c7fee4a4a531
msgid "The Diátaxis compass is something like a truth-table or decision-tree of documentation. It reduces a more complex, two-dimensional problem to its simpler parts, and provides the author with a course-correction tool."
msgstr ""

#: ../../compass.rst:35
#: 437f4c439e75405cb7915e250d3f75b5
msgid "If the content..."
msgstr ""

#: ../../compass.rst:36
#: c8447009c6114e12942cf7a7225bf363
msgid "...and serves the user's..."
msgstr ""

#: ../../compass.rst:37
#: 799d3bdcbeb140ae8bcb6e26acda5931
msgid "...then it must belong to..."
msgstr ""

#: ../../compass.rst:38
#: ../../compass.rst:41
#: e69072fd4ea34d7899e9ff5c92483494
#: abedb3ce353443b9a83031ba9870674e
msgid "informs action"
msgstr ""

