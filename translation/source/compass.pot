msgid "informs action"
msgstr ""

#: ../../compass.rst:39
#: ../../compass.rst:48
#: 4473122488304b6bb260c08ca80402b4
#: 27ff3db3a91844bf8bd77e6537c6e908
msgid "acquisition of skill"
msgstr ""

#: ../../compass.rst:40
#: 97dbacbbe58f420ba9f23741f915951b
msgid "a tutorial"
msgstr ""

#: ../../compass.rst:42
#: ../../compass.rst:45
#: 9d71d16eace24a3cb8f8fb7d36497fac
#: 150740912746496c9041e485f07e9d14
msgid "application of skill"
msgstr ""

#: ../../compass.rst:43
#: 2dbbac5a9b004a28ac7b99880a37634c
