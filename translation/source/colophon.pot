msgstr ""

#: ../../colophon.rst:14
#: 15b2cd3edf154b54a2c2c11617a2735f
msgid "`Email me <daniele@vurt.org>`_. I enjoy hearing about other people's experiences with Diátaxis and read everything I receive."
msgstr ""

#: ../../colophon.rst:16
#: 0ad41dc705124901b0d12e2043f837a2
