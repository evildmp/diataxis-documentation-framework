msgstr "документация"

#: ../../source/foundations.rst:65
msgid "learning"
msgstr "обучение"

#: ../../source/foundations.rst:66
msgid "tutorials"
msgstr "уроки"

#: ../../source/foundations.rst:67 ../../source/foundations.rst:79
msgid "acquires their craft"
msgstr "осваивает навык"

#: ../../source/foundations.rst:68 ../../source/foundations.rst:72
msgid "informs action"
msgstr "помогает действовать"

#: ../../source/foundations.rst:69
msgid "goals"
msgstr "цели"

