msgid "tutorials"
msgstr ""

#: d66e5367bfa84753baef0a69afa496af 7cf8385e696d4bff9a11dc9abdd66810
msgid "acquires their craft"
msgstr ""

#: e45fc707e93d4cc69e953d64a7b03431 066af49897624e50928ac49f328c4f74
msgid "informs action"
msgstr ""

#: 82fd616dcfe14467b9c2db3a3649995b
